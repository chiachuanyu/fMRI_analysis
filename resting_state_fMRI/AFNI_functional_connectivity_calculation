# Make a single map with all ROIs
# IFG_op (a) was generated by FSL, which contains non-binary values, so I have to use a/a to assign its value.
# Other ROIs were also devided by themselves b/c some of them have values 0-2 (i.e., overlapped lACC and rACC)
cd $processed_dir/roiMask
if (! -e ROImap+tlrc.HEAD) then
    3dcalc																							\
        -a ifgop_resample_mask.nii.gz																\
        -b VS_mask.nii.gz																			\
        -c FEF_mask.nii.gz																			\
        -d IPS_mask.nii.gz																			\
        -e DLPFC_mask.nii.gz																		\
        -f Amygdala_mask.nii.gz																		\
        -g AntInsula_mask.nii.gz																	\
        # -h ACC_mask.nii.gz																			\
		-h ACC_basedOnVSWBFC_mask.nii															\
        -i PCC_mask.nii.gz																			\
        -expr 'a/a + (b/b)*2 + (c/c)*3 + (d/d)*4 + (e/e)*5 + (f/f)*6 + (g/g)*7 + (h/h)*8 + (i/i)*9'	\
        -prefix $processed_dir/roiMask/ROImap
endif
cd $processed_dir

# rs-FC analysis with non-blurred time-series data
set pills = ("x" "y")
foreach subj ( `cat subjList.txt` )
	foreach pill ($pills)
        if (-d "${processed_dir}/subject.results/${subj}/${pill}.ses-1.results/") then
            set folder = "${processed_dir}/subject.results/${subj}/${pill}.ses-1.results/"
			set ses = ".ses-1.results"
        else if (-d "${processed_dir}/subject.results/${subj}/${pill}.ses-2.results/") then
            set folder = "${processed_dir}/subject.results/${subj}/${pill}.ses-2.results/"
			set ses = ".ses-2.results"
        else
            echo "No folder found for $subj $pill — skipping"
            continue
        endif
        # if (-d "$folder") then
            # set output_dir = "${processed_dir}/rsFC/${subj}/${pill}"
            # if (! -d "$output_dir") then
                # mkdir -p "$output_dir"
            # endif
            # pushd "$output_dir"
        pushd "${folder}"
        # Extract the uncensored TRs
        set ktrs = `1d_tool.py -infile $raw_dir/${subj}/subject_results/${pill}${ses}/motion_${subj}_censor.1D -show_trs_uncensored encoded`
        echo $ktrs
            
        # # Calculate squared demean motion and squared motion derivatives
		# 1dcat `1deval -1D: -a mot_demean.r01.1D\[0\] -b mot_demean.r01.1D\[0\] -expr 'a*b'` \
			# `1deval -1D: -a mot_demean.r01.1D\[1\] -b mot_demean.r01.1D\[1\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_demean.r01.1D\[2\] -b mot_demean.r01.1D\[2\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_demean.r01.1D\[3\] -b mot_demean.r01.1D\[3\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_demean.r01.1D\[4\] -b mot_demean.r01.1D\[4\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_demean.r01.1D\[5\] -b mot_demean.r01.1D\[5\] -expr 'a*b'` > mot_demean_square.1D
		# 1dcat `1deval -1D: -a mot_deriv.r01.1D\[0\] -b mot_deriv.r01.1D\[0\] -expr 'a*b'` \
			# `1deval -1D: -a mot_deriv.r01.1D\[1\] -b mot_deriv.r01.1D\[1\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_deriv.r01.1D\[2\] -b mot_deriv.r01.1D\[2\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_deriv.r01.1D\[3\] -b mot_deriv.r01.1D\[3\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_deriv.r01.1D\[4\] -b mot_deriv.r01.1D\[4\] -expr 'a*b'`   \
			# `1deval -1D: -a mot_deriv.r01.1D\[5\] -b mot_deriv.r01.1D\[5\] -expr 'a*b'` > mot_deriv_square.1D
            
        # Run 3dDeconvolve again to create a design matrix that further model other covariates that were absent in the 3dDeconvolve during preprocessing.
        # Using non-blurred but somehow preprocessed EPI file as input
        3dDeconvolve -input $raw_dir/${subj}/subject_results/${pill}${ses}/pb03.${subj}.r01.volreg+tlrc.'['$ktrs']'                \
			-ortvec $folder/mot_demean_square.1D'{'$ktrs'}' mot_demean_square               \
			-ortvec $folder/mot_deriv_square.1D'{'$ktrs'}' mot_deriv_square                 \
			-ortvec $raw_dir/${subj}/subject_results/${pill}${ses}/mot_demean.r01.1D'{'$ktrs'}' mot_demean_r01                     \
			-ortvec $raw_dir/${subj}/subject_results/${pill}${ses}/mot_deriv.r01.1D'{'$ktrs'}' mot_deriv_r01                       \
			-ortvec $raw_dir/${subj}/subject_results/${pill}${ses}/psv_csf.1D'{'$ktrs'}' psv_csf                                   \
			-ortvec $raw_dir/${subj}/subject_results/${pill}${ses}/psv_wm.1D'{'$ktrs'}' psv_wm                                     \
			-polort 4                                                               \
			-num_stimts 0                                                           \
			-fout -tout -x1D noblurX.xmat.1D -xjpeg noblurX.jpg                     \
			-x1D_uncensored noblurX.nocensor.xmat.1D                                \
			-fitts noblurfitts.$subj                                                \
			-errts noblurerrts.${subj}                                              \
			-x1D_stop                                                               \
			-bucket noblurstats.$subj
            
        # polort -1 means no polynomial is used
        rm noblurerrts*tproject*
		3dTproject -polort -1 -input $raw_dir/${subj}/subject_results/${pill}${ses}/pb03.${subj}.r01.volreg+tlrc.'['$ktrs']'	\
            -ort noblurX.nocensor.xmat.1D 										\
            -prefix noblurerrts.${subj}.${pill}.tproject
        3dBandpass -quiet -band 0.01 0.1 -input noblurerrts.${subj}.${pill}.tproject+tlrc -prefix noblurerrts.${subj}.${pill}.tproject.bp

        # Calculate Pearson's r and Fisher's z correlation coefficients between ROIs.
        # Should we use a mask?
        3dNetCorr												\
            -inset noblurerrts.${subj}.${pill}.tproject.bp+tlrc \
            -in_rois ${processed_dir}/roiMask/ROImap+tlrc 		\
            -fish_z 											\
            # -ts_wb_corr 										\
            -mask ${processed_dir}/gm_mask_group+tlrc 	\
            -prefix ${subj}.${pill}_ROImap_matrix
        popd
    end
end

# Run seed-based whole-brain FC here rather than above 3dNetCorr
# Calculating 1) ROIs' mean whole-brain connectivities and 2) mean motion, and save them into a csv file.
set seeds = ("ifgop_resample" "VS" "FEF" "IPS" "DLPFC" "Amygdala" "AntInsula" "ACC" "ACC_basedOnVSWBFC" "PCC")
# set seeds = ("ACC_basedOnVSWBFC")
set pills = ("x" "y")
set outfile = "roi_globalFC_mean.tsv"
echo "subject\tseed\tpill\tvalue\tmotion" > $outfile

foreach subj ( `cat ${processed_dir}/subjList.txt` )
    foreach pill ($pills)
        # if ( ! -d "${processed_dir}/rsFC/${subj}/${pill}" ) then
        #     echo "Skipping ${subj} ${pill} (folder not found)"
        #     continue
        # endif
        if (-d "${processed_dir}/subject.results/${subj}/${pill}.ses-1.results/") then
            set folder = "${processed_dir}/subject.results/${subj}/${pill}.ses-1.results/"
            set ses = "ses-1"
        else if (-d "${processed_dir}/subject.results/${subj}/${pill}.ses-2.results/") then
            set folder = "${processed_dir}/subject.results/${subj}/${pill}.ses-2.results/"
            set ses = "ses-2"
        else
            echo "No folder found for $subj $pill — skipping"
            continue
        endif
        pushd "${folder}"
		# Extract the uncensored TRs
        set ktrs = `1d_tool.py -infile $raw_dir/${subj}/subject_results/${pill}.${ses}.results/motion_${subj}_censor.1D -show_trs_uncensored encoded`
        echo $ktrs
        
        # Calculate the average motion
		set mot = `3dTstat -mean -prefix - $raw_dir/${subj}/subject_results/${pill}.${ses}.results/motion_${subj}_enorm.1D\'`
        
        # @ i = 1
        foreach seed ($seeds)
            # set data = ${processed_dir}/rsFC/${subj}/${pill}/${subj}.${pill}_ROImap_matrix_000_INDIV/WB_CORR_ROI_00${i}+tlrc.
            
            # Extract non-smoothed ROIs' time-series average
            3dmaskave -quiet -mask $processed_dir/roiMask/${seed}_mask.nii.gz $raw_dir/${subj}/subject_results/${pill}.${ses}.results/pb03.$subj.r01.volreg+tlrc.'['$ktrs']' > ${seed}_ts.1D
            
            # Run 3dDeconvolve again, but this time using ROI's 1D file (i.e., mean time-series) as input
            3dDeconvolve -input1D ${seed}_ts.1D                                         			\
			#   -censor motion_${subj}_censor.1D                                        			\
			#	-ortvec bandpass_rall.1D bandpass                                       			\
				-ortvec $folder/mot_demean_square.1D'{'$ktrs'}' mot_demean_square                          \
				-ortvec $folder/mot_deriv_square.1D'{'$ktrs'}' mot_deriv_square                            \
				-ortvec $raw_dir/${subj}/subject_results/${pill}.${ses}.results/mot_demean.r01.1D'{'$ktrs'}' mot_demean_r01                                \
				-ortvec $raw_dir/${subj}/subject_results/${pill}.${ses}.results/mot_deriv.r01.1D'{'$ktrs'}' mot_deriv_r01                                  \
				-ortvec $raw_dir/${subj}/subject_results/${pill}.${ses}.results/psv_csf.1D'{'$ktrs'}' psv_csf                                              \
				-ortvec $raw_dir/${subj}/subject_results/${pill}.${ses}.results/psv_wm.1D'{'$ktrs'}' psv_wm                                                \
				-polort 4                                                               			\
				-num_stimts 0                                                           			\
				-fout -tout -x1D seed.noblurX.xmat.1D -xjpeg seed.noblurX.jpg                     	\
				-x1D_uncensored seed.noblurX.nocensor.xmat.1D                                		\
				-fitts seed.noblurfitts.$subj                                                		\
				-errts seed.noblurerrts.${subj}                                              		\
				-x1D_stop                                                               			\
				-bucket seed.noblurstats.$subj
            # Detrend
			rm seed.noblurerrts*tproject.1D
            3dTproject -polort -1 -input ${seed}_ts.1D\'               \
				-ort seed.noblurX.nocensor.xmat.1D -prefix seed.noblurerrts.${subj}.tproject.1D
			3dBandpass -quiet -band 0.01 0.1 -input seed.noblurerrts.${subj}.tproject.1D -prefix seed.noblurerrts.${subj}.tproject.bp.1D
            
            # Run correlation between non-smoothed ts.1D and smoothed errts.$subj.tproject+tlrc. files. Try 0.1 later
            3dfim+ -overwrite -bucket ${seed}_corr -mask $raw_dir/${subj}/subject_results/${pill}.${ses}.results/*pve_1.nii.gz -fim_thr 0.2   \
				-out Correlation -ideal_file seed.noblurerrts.${subj}.tproject.bp.1D\' -input $raw_dir/${subj}/subject_results/${pill}.${ses}.results/errts.${subj}.tproject+tlrc.'['$ktrs']'
            # Convert the whole-brain FCs to Fisher's z
            3dcalc -overwrite -a ${seed}_corr+tlrc. -expr 'atanh(a)' -prefix ${seed}_r2z
            
            
            # set mask = ${processed_dir}/gm_mask_group+tlrc
            # set val = `3dmaskave -mask $mask $data`
            
            # Don't use any mask to calculate mean whole-brain FCs, b/c we want to account for global signals and motions rather than really analyzing the whole-brain FCs (we could, but this is not the current interest).
            set val = `3dmaskave ${seed}_r2z*`
            echo "${subj}\t${seed}\t${pill}\t${val}\t${mot}" >> $processed_dir/$outfile
            @ i++
        end
    end
end


