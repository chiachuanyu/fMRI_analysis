#SBATCH --job-name=REML_array
#SBATCH --account=amandaelton
#SBATCH --qos=amandaelton
#SBATCH --output=reml_logs/REML_%A_%a.out
#SBATCH --error=reml_logs/REML_%A_%a.err
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --mem=40gb
#SBATCH --time=02:00:00
#SBATCH --array=1-69%2

subj=$(sed -n "${SLURM_ARRAY_TASK_ID}p" /blue/amandaelton/ch.yu/BYTE/subject_results/group.sst_batch/folder.txt)

resultDir=/blue/amandaelton/ch.yu/BYTE/subject_results/group.sst_batch/${subj}.results
# resultDir=$(echo /blue/amandaelton/ch.yu/BYTE/subject_results/group.sst_batch/${subj}.results*)

submitDir=$PWD/reml_logs

if [ -d "$resultDir" ]; then
    cd $resultDir
    echo "Running 3dREMLfit for ${subj}"
    3dREMLfit -matrix X.xmat.1D \
    -input "pb04.${subj}.r01.scale+tlrc.HEAD pb04.${subj}.r02.scale+tlrc.HEAD" \
    -fout -tout -Rbuck stats.${subj}_REML -Rvar stats.${subj}_REMLvar \
    -GOFORIT 4 -Rfitts fitts.${subj}_REML -Rerrts errts.${subj}_REML -verb -overwrite
else
    echo "${subj} has file(s) missing, skipping."
fi

mv "${submitDir}/REML_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.out" "${submitDir}/REML_${SLURM_ARRAY_JOB_ID}_${subj}.out"
mv "${submitDir}/REML_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.err" "${submitDir}/REML_${SLURM_ARRAY_JOB_ID}_${subj}.err"

