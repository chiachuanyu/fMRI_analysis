# Cyberball
# There are 9 event types for all subjects (Schulz et al., 2022 also have a "throw" event, but our event-related design may not be able to differentiate it from accept events, talk to Amanda later):
# Inclusion block (onset: dummyEnd.stopped): in_accept, in_notMyTurn, in_null
# Exclusion block (onset: dummyEnd.stopped): ex_accept, ex_reject, ex_null
# Re-inclusion block (onset: dummyEnd.stopped): rein_accept, rein_notMyTurn, rein_null

cd /blue/amandaelton/ch.yu/BYTE/BYTE_timing/cyber_task_timing

foreach subj ( `cat ../subjList.txt` )
    if ( -f "${subj}_cyberball_time_inclu.csv" ) then
        echo ${subj}_cyberball_time_inclu
        awk -F', *' -v type="_13" 'NR>1 && $4 ~ (type "$") {print $1}' ${subj}_cyberball_time_inclu.csv > ${subj}_cyberball_time_in_notMyTurn.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_in_notMyTurn.txt -write_timing ${subj}_cyberball_time_in_notMyTurn.1D
        
        awk -F', *' -v type="_2" 'NR>1 && $4 ~ (type "$") {print $2}' ${subj}_cyberball_time_inclu.csv > ${subj}_cyberball_time_in_accept.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_in_accept.txt -write_timing ${subj}_cyberball_time_in_accept.1D
        
        awk -F', *' -v type="_null" 'NR>1 && $4 ~ (type "$") {print $3}' ${subj}_cyberball_time_inclu.csv > ${subj}_cyberball_time_in_null.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_in_null.txt -write_timing ${subj}_cyberball_time_in_null.1D
    else
        echo "Missing: ${subj}_cyberball_time_inclu.csv (skipping inclusion)"
    endif
	
    if ( -f "${subj}_cyberball_time_exclu.csv" ) then
        echo ${subj}_cyberball_time_exclu
        awk -F', *' -v type="_13" 'NR>1 && $4 ~ (type "$") {print $1}' ${subj}_cyberball_time_exclu.csv > ${subj}_cyberball_time_ex_notMyTurn.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_ex_notMyTurn.txt -write_timing ${subj}_cyberball_time_ex_notMyTurn.1D
        
        awk -F', *' -v type="_2" 'NR>1 && $4 ~ (type "$") {print $2}' ${subj}_cyberball_time_exclu.csv > ${subj}_cyberball_time_ex_accept.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_ex_accept.txt -write_timing ${subj}_cyberball_time_ex_accept.1D
        
        awk -F', *' -v type="_null" 'NR>1 && $4 ~ (type "$") {print $3}' ${subj}_cyberball_time_exclu.csv > ${subj}_cyberball_time_ex_null.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_ex_null.txt -write_timing ${subj}_cyberball_time_ex_null.1D
    else
        echo "Missing: ${subj}_cyberball_time_exclu.csv (skipping exclusion)"
    endif

    if ( -f "${subj}_cyberball_time_reinclu.csv" ) then
        echo ${subj}_cyberball_time_reinclu
        awk -F', *' -v type="_13" 'NR>1 && $4 ~ (type "$") {print $1}' ${subj}_cyberball_time_reinclu.csv > ${subj}_cyberball_time_rein_notMyTurn.txt
