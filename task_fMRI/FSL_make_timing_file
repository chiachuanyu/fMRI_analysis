        awk -F', *' -v type="_2" 'NR>1 && $4 ~ (type "$") {print $2}' ${subj}_cyberball_time_reinclu.csv > ${subj}_cyberball_time_rein_accept.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_rein_accept.txt -write_timing ${subj}_cyberball_time_rein_accept.1D
        
        awk -F', *' -v type="_null" 'NR>1 && $4 ~ (type "$") {print $3}' ${subj}_cyberball_time_reinclu.csv > ${subj}_cyberball_time_rein_null.txt
        timing_tool.py -fsl_timing_files ${subj}_cyberball_time_rein_null.txt -write_timing ${subj}_cyberball_time_rein_null.1D
    else
        echo "Missing: ${subj}_cyberball_time_reinclu.csv (skipping reinclusion)"
    endif
end

